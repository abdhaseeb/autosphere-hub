// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  VEHICLE
  PART
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  DELAYED
  DELIVERED
}

enum ServiceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  region    String
  email     String   @unique
  createdAt DateTime @default(now())

  orders          Order[]
  serviceRequests ServiceRequest[]
}

model Product {
  id        String      @id @default(uuid())
  name      String
  type      ProductType
  category  String
  price     Float
  createdAt DateTime    @default(now())

  inventory  Inventory?
  orderItems OrderItem[]
}

model Inventory {
  id           String @id @default(uuid())
  productId    String @unique
  availableQty Int
  reservedQty  Int

  product Product @relation(fields: [productId], references: [id])
}

model Order {
  id          String      @id @default(uuid())
  supplierId  String
  status      OrderStatus
  totalAmount Float
  createdAt   DateTime    @default(now())

  supplier Supplier    @relation(fields: [supplierId], references: [id])
  items    OrderItem[]
  shipment Shipment?

  serviceRequests ServiceRequest[]
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Shipment {
  id               String         @id @default(uuid())
  orderId          String         @unique
  status           ShipmentStatus
  shippedAt        DateTime?
  expectedDelivery DateTime?
  deliveredAt      DateTime?

  order Order @relation(fields: [orderId], references: [id])
}

model ServiceRequest {
  id         String        @id @default(uuid())
  supplierId String
  orderId    String?
  type       String
  status     ServiceStatus
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?

  supplier Supplier @relation(fields: [supplierId], references: [id])
  order    Order?   @relation(fields: [orderId], references: [id])
}

model DailyStats{
  date            DateTime @id
  totalOrders     Int
  totalRevenue    Float
  deliveredCount  Int
  delayedCount    Int

  createdAt       DateTime @default(now())
}